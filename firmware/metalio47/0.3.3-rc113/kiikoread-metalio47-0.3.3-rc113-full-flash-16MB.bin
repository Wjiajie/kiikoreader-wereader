<section class="upload" data-kind="book"><h2>ä¸Šä¼ ä¹¦ç±</h2><p class="hint">EPUBã€TXT â†’ booksã€‚åŒåæ–‡ä»¶ä¼šå…ˆè¯¢é—®ã€‚</p><input type="file" accept=".epub,.txt" multiple aria-label="é€‰æ‹©ä¹¦ç±"><button class="primary send" type="button">ä¸Šä¼ åˆ° books</button><p class="result" role="status"></p></section>
<section class="upload" data-kind="font"><h2>ä¸Šä¼ å­—ä½“</h2><p class="hint">TTFã€OTF â†’ fontsã€‚ä¸Šä¼ åå¯åœ¨è®¾å¤‡å­—ä½“è®¾ç½®ä¸­é€‰æ‹©ã€‚</p><input type="file" accept=".ttf,.otf" multiple aria-label="é€‰æ‹©å­—ä½“"><button class="primary send" type="button">ä¸Šä¼ åˆ° fonts</button><p class="result" role="status"></p></section>
<section id="wallpaper"><h2>è®¾ç½®é”å±å£çº¸</h2><p class="hint">é€‰æ‹©æ‰‹æœºä¸­çš„å›¾ç‰‡ï¼Œæ‹–åŠ¨è£å‰ªæ¡†é‡Œçš„ç”»é¢ï¼Œç”¨æ»‘å—ç¼©æ”¾ã€‚ä¸Šä¼ åè‡ªåŠ¨åˆ‡æ¢ä¸ºå£çº¸é”å±ã€‚</p><div class="crop-layout"><canvas id="cropPreview" class="crop-preview" width="342" height="608" aria-label="684 Ã— 1216 é”å±è£å‰ªé¢„è§ˆ"></canvas><div class="crop-controls"><input id="wallpaperFile" type="file" accept="image/*" aria-label="é€‰æ‹©é”å±å›¾ç‰‡"><label for="cropZoom">ç¼©æ”¾å›¾ç‰‡</label><input id="cropZoom" type="range" min="1" max="3" step="0.01" value="1" aria-label="ç¼©æ”¾å›¾ç‰‡"><p class="muted">è¾“å‡ºå°ºå¯¸ï¼š684 Ã— 1216 åƒç´ ã€‚å¯åœ¨æ¡†å†…æ‹–åŠ¨è°ƒæ•´ä½ç½®ã€‚</p><button id="cropReset" type="button">å±…ä¸­é‡ç½®</button><button id="wallpaperSend" class="primary" type="button" disabled>è£å‰ªå¹¶è®¾ä¸ºé”å±</button><p id="wallpaperResult" class="result" role="status">è¯·å…ˆé€‰æ‹©å›¾ç‰‡</p></div></div></section>
<section class="upload" data-kind="picture"><h2>ä¸Šä¼ å›¾ç‰‡</h2><p class="hint">JPGã€JPEGã€PNG â†’ picturesã€‚å¯åœ¨è®¾å¤‡ä¸Šé€‰æ‹©ç”¨ä½œé”å±å£çº¸ã€‚</p><input type="file" accept=".jpg,.jpeg,.png" multiple aria-label="é€‰æ‹©å›¾ç‰‡"><button class="primary send" type="button">ä¸Šä¼ åˆ° pictures</button><p class="result" role="status"></p></section>
<dialog id="editor"><h2 id="editorTitle"></h2><p id="editorDescription"></p><input id="editorName" type="text" maxlength="238" aria-label="æ–°åç§°"><div class="dialog-actions"><button id="editorCancel" type="button">å–æ¶ˆ</button><button id="editorConfirm" class="primary" type="button">ç¡®è®¤</button></div></dialog>
<script>
const $=id=>document.getElementById(id);
let policy=null,busy=false,path='',page=0,pages=0,editorAction=null;
const size=n=>n>=1048576?(n/1048576).toFixed(1)+' MB':n>=1024?Math.ceil(n/1024)+' KB':n+' B';
const join=(dir,name)=>dir?dir+'/'+name:name;
async function request(url,options){const response=await fetch(url,{cache:'no-store',...options});let body;try{body=await response.json()}catch{throw Error('è®¾å¤‡å“åº”æ— æ³•è§£æï¼Œè¯·é‡è¯•')}return {status:response.status,body}}
function lock(value){busy=value;document.querySelectorAll('button,input[type=file],input[type=range],#signatureText').forEach(el=>{if(el.id!=='editorCancel')el.disabled=value});if(!value){$('up').disabled=!path;$('previous').disabled=page<=0;$('next').disabled=page+1>=pages;$('wallpaperSend').disabled=!cropImage}}
async function info(){const r=await request('/info');if(r.status!==200)throw Error(r.body.error||'æ— æ³•è¯»å–å­˜å‚¨çŠ¶æ€');policy=r.body;$('storage').textContent=(policy.is_flash?'æœªæ£€æµ‹åˆ° TF å¡':'TF å¡å·²å°±ç»ª')+' Â· å‰©ä½™ '+size(policy.free_bytes);if(policy.is_flash){$('browser').hidden=true;document.querySelectorAll('.upload').forEach(el=>el.hidden=true);$('storage').textContent='æœªæ£€æµ‹åˆ° TF å¡ï¼Œè¯·æ’å¡åé‡æ–°è¿›å…¥ä¼ è¾“é¡µé¢'}}
async function loadDirectory(){if(policy.is_flash)return;const r=await request('/files?'+(path?'path='+encodeURIComponent(path)+'&':'')+'page='+page);if(r.status!==200)throw Error(r.body.error||'ç›®å½•è¯»å–å¤±è´¥');pages=r.body.pages;if(page>=pages&&page){page=0;return loadDirectory()}$('path').textContent='/'+path;$('listState').textContent=r.body.total+' é¡¹';$('pageState').textContent=(pages?page+1:0)+' / '+pages;$('entries').replaceChildren();for(const item of r.body.items){const row=document.createElement('li'),name=document.createElement('div'),actions=document.createElement('div'),detail=document.createElement('small');name.className='entry-name';actions.className='entry-actions';detail.textContent=item.directory?'æ–‡ä»¶å¤¹':size(item.size);if(item.directory){const open=document.createElement('button');open.className='folder';open.textContent='â–±  '+item.name;open.onclick=()=>{path=join(path,item.name);page=0;loadDirectory().catch(showError)};name.append(open)}else{name.textContent=item.name}name.append(detail);for(const action of ['rename','copy','delete']){const button=document.createElement('button');button.className='tiny'+(action==='delete'?' danger':'');button.textContent={rename:'é‡å‘½å',copy:'å¤åˆ¶',delete:'åˆ é™¤'}[action];button.onclick=()=>openEditor(action,item);actions.append(button)}row.append(name,actions);$('entries').append(row)}$('up').disabled=!path;$('previous').disabled=page<=0;$('next').disabled=page+1>=pages}
function showError(error){$('listState').textContent=error.message||String(error)}
function openEditor(action,item){if(busy)return;const source=item?join(path,item.name):path;editorAction={action,source,item};$('editorTitle').textContent={rename:'é‡å‘½å',copy:'å¤åˆ¶',delete:'åˆ é™¤',mkdir:'æ–°å»ºæ–‡ä»¶å¤¹'}[action];$('editorDescription').textContent=action==='delete'?source+(item.directory?'ï¼ˆä¼šåˆ é™¤å…¶ä¸­æ‰€æœ‰æ–‡ä»¶ï¼‰':''):'ä½ç½®ï¼š/'+path;$('editorName').hidden=action==='delete';$('editorName').value=action==='copy'?(item.directory?item.name+' å‰¯æœ¬':item.name.replace(/(\.[^.]+)?$/,' å‰¯æœ¬$1')):item?item.name:'';$('editorConfirm').textContent=action==='delete'?'ç¡®è®¤åˆ é™¤':'ä¿å­˜';$('editorConfirm').classList.toggle('danger',action==='delete');$('editor').showModal();if(action!=='delete')$('editorName').focus()}
$('editorCancel').onclick=()=>$('editor').close();
$('editorConfirm').onclick=async()=>{if(!editorAction)return;const {action,source}=editorAction;const name=$('editorName').value.trim();if(action!=='delete'&&(!name||name==='.'||name==='..'||/[\\/:*?"<>|]/.test(name))){$('editorDescription').textContent='åç§°ä¸èƒ½åŒ…å«æ–œæ æˆ–ç‰¹æ®Šç¬¦å·';return}const target=action==='delete'?'':join(path,name);if(action!=='delete'&&new TextEncoder().encode(target).length>238){$('editorDescription').textContent='è·¯å¾„è¿‡é•¿ï¼Œè¯·ç¼©çŸ­åç§°';return}const payload={action,path:source,...(action==='delete'?{}:{target})};$('editorConfirm').disabled=true;try{const r=await request('/files',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(r.status!==200)throw Error(r.body.error||'æ“ä½œå¤±è´¥');$('editor').close();await info();await loadDirectory()}catch(error){$('editorDescription').textContent=error.message}finally{$('editorConfirm').disabled=false}};
$('refresh').onclick=()=>loadDirectory().catch(showError);
$('up').onclick=()=>{if(!path)return;path=path.includes('/')?path.slice(0,path.lastIndexOf('/')):'';page=0;loadDirectory().catch(showError)};
$('newFolder').onclick=()=>openEditor('mkdir');
$('previous').onclick=()=>{if(page){--page;loadDirectory().catch(showError)}};
$('next').onclick=()=>{if(page+1<pages){++page;loadDirectory().catch(showError)}};
async function loadSignature(){const r=await request('/signature');if(r.status!==200)throw Error(r.body.error||'æ— æ³•è¯»å–ç­¾å');$('signatureText').value=r.body.signature||'';$('signatureResult').textContent='å¯ç¼–è¾‘ç­¾ååä¿å­˜'}
$('signatureSave').onclick=async()=>{if(busy)return;const text=$('signatureText').value,result=$('signatureResult');if(new TextEncoder().encode(text).length>95){result.textContent='ç­¾åè¿‡é•¿ï¼Œæœ€å¤š95å­—èŠ‚ï¼ˆçº¦31ä¸ªæ±‰å­—ï¼‰';return}if(/[\x00-\x1f\x7f\u2028\u2029]/.test(text)){result.textContent='ç­¾åä¸èƒ½åŒ…å«æ¢è¡Œæˆ–æ§åˆ¶å­—ç¬¦';return}lock(true);try{result.textContent='æ­£åœ¨ä¿å­˜â€¦';const r=await request('/signature',{method:'POST',headers:{'Content-Type':'text/plain; charset=utf-8'},body:text});if(r.status!==200)throw Error(r.body.error||'ä¿å­˜å¤±è´¥');result.textContent=text?'ç­¾åå·²ä¿å­˜ï¼Œkiikoread çŠ¶æ€æ å·²æ›´æ–°':'ç­¾åå·²æ¸…é™¤'}catch(error){result.textContent=error.message}finally{lock(false)}};
loadSignature().catch(error=>$('signatureResult').textContent=error.message);
function transferRate(bytes,elapsed){const seconds=Math.max(elapsed,1)/1000;return (bytes/seconds/1000).toFixed(0)+' KB/s Â· å·²ç”¨ '+seconds.toFixed(1)+' ç§’'}
function uploadProgress(name,done,total,elapsed){return (done>=total?'ç­‰å¾…è®¾å¤‡ç¡®è®¤ ':'æ­£åœ¨ä¸Šä¼  ')+name+' Â· '+size(done)+' / '+size(total)+' Â· '+transferRate(done,elapsed)}
function upload(file,url,onProgress){return new Promise((resolve,reject)=>{
 const xhr=new XMLHttpRequest();xhr.open('PUT',url);
 const start=performance.now();let loaded=0,total=file.size;
 const paint=()=>onProgress(loaded,total,performance.now()-start);
 const timer=setInterval(paint,1000);
 xhr.upload.onprogress=e=>{loaded=e.loaded;total=e.total||file.size;paint()};
 xhr.onload=()=>{clearInterval(timer);try{resolve({status:xhr.status,body:JSON.parse(xhr.responseText),elapsed:performance.now()-start})}catch{reject(Error('è®¾å¤‡å“åº”æ— æ³•è§£æï¼Œè¯·æ£€æŸ¥æ–‡ä»¶æ˜¯å¦å·²ä¿å­˜'))}};
 xhr.onerror=()=>{clearInterval(timer);reject(Error('è¿æ¥ä¸­æ–­ï¼Œè¯·ä¿æŒè®¾å¤‡ä¼ ä¹¦é¡µé¢å¼€å¯å¹¶æ£€æŸ¥ç½‘ç»œè¿æ¥'))};
 xhr.onabort=()=>{clearInterval(timer);reject(Error('ä¸Šä¼ å·²å–æ¶ˆï¼Œå°šæœªç¡®è®¤ä¿å­˜'))};
 try{xhr.send(file)}catch(error){clearInterval(timer);reject(error)}
})}
const types={file:{re:null,url:'/file-upload',limit:0},book:{re:/\.(epub|txt)$/i,url:'/upload',limit:0},font:{re:/\.(ttf|otf)$/i,url:'/font-upload',limit:33554432},picture:{re:/\.(jpg|jpeg|png)$/i,url:'/image-upload',limit:20971520}};
const cropWidth=684,cropHeight=1216;
let cropImage=null,cropZoom=1,cropX=0,cropY=0,cropPointer=null;
function cropScale(){return cropImage?Math.max(cropWidth/cropImage.naturalWidth,cropHeight/cropImage.naturalHeight)*cropZoom:1}
function clampCrop(){if(!cropImage)return;const width=cropImage.naturalWidth*cropScale(),height=cropImage.naturalHeight*cropScale();cropX=Math.min(0,Math.max(cropWidth-width,cropX));cropY=Math.min(0,Math.max(cropHeight-height,cropY))}
function drawCrop(canvas){const ctx=canvas.getContext('2d');ctx.setTransform(canvas.width/cropWidth,0,0,canvas.height/cropHeight,0,0);ctx.fillStyle='#f4f4f2';ctx.fillRect(0,0,cropWidth,cropHeight);if(cropImage)ctx.drawImage(cropImage,cropX,cropY,cropImage.naturalWidth*cropScale(),cropImage.naturalHeight*cropScale());else{ctx.fillStyle='#777d77';ctx.font='32px sans-serif';ctx.textAlign='center';ctx.fillText('684 Ã— 1216',cropWidth/2,cropHeight/2)}}
function resetCrop(){if(!cropImage)return;cropZoom=1;$('cropZoom').value='1';cropX=(cropWidth-cropImage.naturalWidth*cropScale())/2;cropY=(cropHeight-cropImage.naturalHeight*cropScale())/2;clampCrop();drawCrop($('cropPreview'))}
$('wallpaperFile').onchange=()=>{const file=$('wallpaperFile').files[0];cropImage=null;$('wallpaperSend').disabled=true;if(!file){drawCrop($('cropPreview'));return}const url=URL.createObjectURL(file),image=new Image();$('wallpaperResult').textContent='æ­£åœ¨è¯»å–å›¾ç‰‡â€¦';image.onload=()=>{URL.revokeObjectURL(url);if(!image.naturalWidth||!image.naturalHeight){$('wallpaperResult').textContent='å›¾ç‰‡å°ºå¯¸æ— æ•ˆ';return}cropImage=image;resetCrop();$('wallpaperSend').disabled=false;$('wallpaperResult').textContent='æ‹–åŠ¨å›¾ç‰‡å¹¶è°ƒæ•´ç¼©æ”¾åä¸Šä¼ '};image.onerror=()=>{URL.revokeObjectURL(url);$('wallpaperResult').textContent='æ­¤å›¾ç‰‡æ— æ³•è¯»å–ï¼Œè¯·æ¢ä¸€å¼ '};image.src=url};
$('cropZoom').oninput=()=>{if(!cropImage)return;const next=Number($('cropZoom').value),ratio=next/cropZoom;cropX=cropWidth/2-(cropWidth/2-cropX)*ratio;cropY=cropHeight/2-(cropHeight/2-cropY)*ratio;cropZoom=next;clampCrop();drawCrop($('cropPreview'))};
$('cropReset').onclick=resetCrop;
$('cropPreview').onpointerdown=event=>{if(!cropImage||busy)return;cropPointer={id:event.pointerId,x:event.clientX,y:event.clientY};$('cropPreview').setPointerCapture(event.pointerId)};
$('cropPreview').onpointermove=event=>{if(!cropPointer||cropPointer.id!==event.pointerId)return;const ratio=cropWidth/$('cropPreview').getBoundingClientRect().width;cropX+=(event.clientX-cropPointer.x)*ratio;cropY+=(event.clientY-cropPointer.y)*ratio;cropPointer.x=event.clientX;cropPointer.y=event.clientY;clampCrop();drawCrop($('cropPreview'))};
$('cropPreview').onpointerup=$('cropPreview').onpointercancel=()=>{cropPointer=null};
$('wallpaperSend').onclick=async()=>{if(!cropImage||busy)return;const result=$('wallpaperResult');if(!policy||policy.is_flash){result.textContent='è®¾å¤‡æœªè¿æ¥æˆ– TF å¡æœªå°±ç»ª';return}lock(true);try{result.textContent='æ­£åœ¨åˆ¶ä½œ 684 Ã— 1216 å£çº¸â€¦';const canvas=document.createElement('canvas');canvas.width=cropWidth;canvas.height=cropHeight;drawCrop(canvas);let blob=null;for(const quality of [0.86,0.72,0.56,0.42]){blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',quality));if(blob&&blob.size<=2097152)break}if(!blob)throw Error('æ‰‹æœºæ— æ³•ç”Ÿæˆè£å‰ªå›¾ç‰‡');if(blob.size>2097152)throw Error('å›¾ç‰‡ä»è¿‡å¤§ï¼Œè¯·æ¢ä¸€å¼ å›¾ç‰‡');if(blob.size>policy.free_bytes)throw Error('TF å¡ç©ºé—´ä¸è¶³');const name='pico-wallpaper-'+Date.now()+'.jpg';const url='/image-upload?name='+encodeURIComponent(name)+'&wallpaper=1';const response=await upload(blob,url,(done,total,elapsed)=>result.textContent=uploadProgress('å£çº¸',done,total,elapsed));if(response.status!==200)throw Error(response.body.error||'å£çº¸ä¸Šä¼ å¤±è´¥');result.textContent='å·²è®¾ä¸ºå£çº¸é”å±';await info();if(path==='pictures')await loadDirectory()}catch(error){result.textContent=error.message}finally{lock(false)}};
drawCrop($('cropPreview'));
async function sendFiles(section){
 if(busy||!policy||policy.is_flash)return;
 const kind=section.dataset.kind,config=types[kind],files=[...section.querySelector('input').files],result=section.querySelector('.result'),destination=path;
 if(!files.length){result.textContent='è¯·å…ˆé€‰æ‹©æ–‡ä»¶';return}
 lock(true);
 let saved=0,failed=0;
 try{for(const file of files){try{
  if(config.re&&(!config.re.test(file.name)||file.name.startsWith('.')))throw Error('æ–‡ä»¶æ ¼å¼ä¸æ”¯æŒ');
  if(kind!=='file'&&!file.size)throw Error('æ–‡ä»¶ä¸ºç©º');
  if((config.limit&&file.size>config.limit)||(kind==='book'&&policy.file_limit&&file.size>policy.file_limit))throw Error('æ–‡ä»¶è¶…è¿‡ä¸Šé™');
  if(file.size>policy.free_bytes)throw Error('TF å¡å‰©ä½™ç©ºé—´ä¸è¶³');
  const target=join(destination,file.name);
  if(kind==='file'&&new TextEncoder().encode(target).length>238)throw Error('è·¯å¾„è¿‡é•¿ï¼Œè¯·ç¼©çŸ­åç§°');
  const shown=kind==='file'?'/'+target:file.name;
  result.textContent='æ­£åœ¨ä¸Šä¼  '+shown;
  const url=config.url+(kind==='file'?'?path='+encodeURIComponent(target):'?name='+encodeURIComponent(file.name));
  let response=await upload(file,url,(done,total,elapsed)=>result.textContent=uploadProgress(shown,done,total,elapsed));
  if(response.status===409&&confirm('åŒåæ–‡ä»¶å·²å­˜åœ¨ï¼Œæ˜¯å¦æ›¿æ¢ï¼Ÿ\n'+shown))response=await upload(file,url+'&overwrite=1',(done,total,elapsed)=>result.textContent=uploadProgress(shown,done,total,elapsed));
  if(response.status!==200)throw Error(response.body.error||'ä¸Šä¼ å¤±è´¥');
  ++saved;result.textContent='å·²ä¿å­˜ '+shown+' Â· '+transferRate(file.size,response.elapsed);
  await info();
  if(kind==='file'||path==={book:'books',font:'fonts',picture:'pictures'}[kind])await loadDirectory();
 }catch(error){++failed;result.textContent=file.name+'ï¼š'+error.message}}
 if(files.length>1)result.textContent='å·²ä¿å­˜ '+saved+' ä¸ªæ–‡ä»¶'+(kind==='file'?'åˆ° /'+destination:'')+(failed?' Â· '+failed+' ä¸ªæœªä¿å­˜':'');
 }finally{lock(false)}
}
document.querySelectorAll('.upload').forEach(section=>section.querySelector('.send').onclick=()=>sendFiles(section));
info().then(loadDirectory).catch(error=>$('storage').textContent=error.message+'ï¼Œè¯·åˆ·æ–°ç½‘é¡µé‡è¯•');
