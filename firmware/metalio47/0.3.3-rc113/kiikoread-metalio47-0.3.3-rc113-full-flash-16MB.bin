<style>
:root{color-scheme:light;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans SC",system-ui,sans-serif;color:#202221;background:#ededeb}
*{box-sizing:border-box}body{max-width:760px;margin:0 auto;padding:26px 20px 68px;font-size:16px;line-height:1.55}
header{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:8px 0 22px}
h1{font-size:36px;line-height:1.15;letter-spacing:-.03em;margin:0}h2{font-size:23px;line-height:1.25;margin:0 0 9px}
section{background:#fff;border:1px solid #d2d4d0;border-radius:22px;padding:23px;margin:15px 0}
.eyebrow,.muted{color:#696d68;font-size:14px}.eyebrow{letter-spacing:.14em;margin:0 0 8px}
.hint{color:#626762;margin:4px 0 15px}.line{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
#storage{font-weight:600}button,input{font:inherit;max-width:100%}
button{min-height:42px;padding:8px 15px;border:1px solid #c5c8c4;border-radius:13px;color:#202221;background:#f7f7f5;cursor:pointer}
button:hover{background:#e8eae7}button:disabled{opacity:.45;cursor:default}
.primary{background:#303331;color:#fff;border-color:#303331}.primary:hover{background:#484b49}
.danger{color:#943b34}.tiny{min-height:34px;padding:5px 10px;font-size:14px}
input[type=file]{width:100%;padding:13px;border:1px dashed #a8ada8;border-radius:13px;background:#fafaf9}
input[type=text]{width:100%;min-height:44px;padding:9px 12px;border:1px solid #b9bdb9;border-radius:11px}
.upload h2,.upload .hint{margin-bottom:9px}.upload .send{margin-top:10px}
.result{min-height:24px;margin:9px 0 0;color:#4f5751;overflow-wrap:anywhere}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:13px 0}#path{font-weight:600;overflow-wrap:anywhere}
ul{list-style:none;padding:0;margin:0}li{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:60px;padding:11px 0;border-top:1px solid #e1e3df}
.entry-name{min-width:0;flex:1;overflow-wrap:anywhere}.entry-name small{display:block;color:#6a6e69;font-size:13px}
.entry-actions{display:flex;flex-wrap:wrap;justify-content:end;gap:6px}.folder{font-weight:600;text-align:left;border:0;background:none;padding:0}.folder:hover{background:none;text-decoration:underline}
.pages{display:flex;gap:8px;align-items:center;justify-content:end;margin-top:14px}
dialog{width:min(92vw,420px);border:1px solid #c8cac6;border-radius:20px;padding:22px;background:#fff;color:#202221;box-shadow:0 18px 60px #0003}
dialog::backdrop{background:#20222175}dialog h2{margin-bottom:10px}dialog p{margin:8px 0 16px;color:#626762;overflow-wrap:anywhere}
.dialog-actions{display:flex;justify-content:end;gap:8px;margin-top:18px}section[hidden]{display:none}
.crop-layout{display:flex;align-items:start;gap:22px;flex-wrap:wrap}.crop-preview{display:block;width:min(100%,260px);height:auto;aspect-ratio:684/1216;border:2px solid #626662;border-radius:14px;background:#e2e3e0;touch-action:none;cursor:grab}.crop-preview:active{cursor:grabbing}
.crop-controls{flex:1;min-width:220px}.crop-controls label{display:block;margin:14px 0 5px;font-weight:600}.crop-controls input[type=range]{width:100%;accent-color:#303331}.crop-controls .primary{margin-top:16px}
@media(max-width:540px){body{padding:18px 12px 48px;font-size:15px}header{align-items:start}h1{font-size:31px}section{padding:17px;border-radius:19px}.entry-actions{width:100%;justify-content:start}li{flex-wrap:wrap}}
</style>
